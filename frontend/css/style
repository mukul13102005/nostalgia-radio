:root{
  --bg:#0d0d12; --bg2:#16151d; --card:#1c1b24; --card2:#23212d;
  --text:#f3f1ec; --muted:#a9a4b3; --line:rgba(255,255,255,0.09);
  --accent-c:#ffb703;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--bg); color:var(--text);
  font-family:'Poppins',sans-serif;
  min-height:100vh; overflow-x:hidden;
}
.dev{ font-family:'Noto Sans Devanagari','Poppins',sans-serif; }

/* ===== topbar (always clean/minimal) ===== */
.topbar{
  position:sticky; top:0; z-index:50;
  display:flex; align-items:center; gap:8px;
  padding:12px 14px; backdrop-filter:blur(10px);
  background:rgba(10,10,14,0.6); border-bottom:1px solid var(--line);
}
.brand{margin-right:auto; font-weight:800; font-size:15px; display:flex; align-items:center; gap:8px;}
.brand span.tag{font-size:10px; font-weight:600; background:var(--accent-c); color:#1a1300; padding:2px 8px; border-radius:999px;}
.icon-btn{
  width:38px; height:38px; border-radius:50%; border:1px solid var(--line); background:var(--card);
  display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px; color:var(--text);
  position:relative;
}
.online-badge{
  position:absolute; bottom:-4px; right:-4px; background:#3ddc74; color:#04240f;
  font-size:9px; font-weight:800; padding:1px 5px; border-radius:999px; border:2px solid var(--bg);
}

/* ===== theme dropdown ===== */
.theme-dd-wrap{ position:relative; padding:10px 14px 0; max-width:640px; margin:0 auto; }
.theme-dd-btn{
  width:100%; display:flex; align-items:center; gap:10px;
  padding:12px 14px; border-radius:14px; border:1px solid var(--line); background:var(--card);
  cursor:pointer; color:var(--text); font-weight:700; font-size:14px;
}
.theme-dd-btn .ic{font-size:19px;}
.theme-dd-btn .lbl{flex:1; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.theme-dd-btn .chev{transition:transform .2s ease; opacity:.6;}
.theme-dd-btn.open .chev{transform:rotate(180deg);}
.theme-dd-list{
  position:absolute; left:14px; right:14px; top:calc(100% + 4px); z-index:60;
  background:var(--card); border:1px solid var(--line); border-radius:14px; overflow:hidden;
  box-shadow:0 18px 40px rgba(0,0,0,.45); display:none; max-height:70vh; overflow-y:auto;
}
.theme-dd-list.open{display:block;}
.theme-dd-item{
  display:flex; align-items:center; gap:10px; padding:12px 14px; cursor:pointer; font-size:13.5px; font-weight:600;
  border-bottom:1px solid var(--line);
}
.theme-dd-item:last-child{border-bottom:none;}
.theme-dd-item:hover{ background:var(--card2); }
.theme-dd-item.active{ color:var(--accent-c); }
.theme-dd-item .ic{font-size:17px;}
.theme-dd-item .tag2{margin-left:auto; font-size:10.5px; color:var(--muted); font-weight:500;}

/* ===== hero (first screen — clean) ===== */
.hero{
  position:relative; padding:36px 20px 26px; text-align:center; overflow:hidden;
  background:var(--hero-bg); transition:background .5s ease;
  border-bottom:1px solid var(--line);
}
.hero-inner{position:relative; z-index:2;}
.hero-illust{ max-width:280px; margin:0 auto 4px; filter:drop-shadow(0 10px 22px rgba(0,0,0,.4)); }
.hero-illust svg{ width:100%; height:auto; display:block; }
.hero h1{
  margin:0 0 6px; font-size:clamp(26px,7vw,40px); line-height:1.1; font-weight:900;
  color:#fff; text-shadow:0 3px 18px rgba(0,0,0,.35);
}
.hero p.tagline{
  margin:0 auto; max-width:480px; font-size:13.5px; color:#fff; opacity:.85; font-weight:500;
}

/* ===== player (part of first clean screen) ===== */
.player-wrap{padding:16px 16px 4px;}
.player{
  max-width:640px; margin:-20px auto 0; position:relative; z-index:3;
  background:var(--card); border:1px solid var(--line); border-radius:18px;
  padding:14px 16px; display:flex; align-items:center; gap:12px;
  box-shadow:0 18px 40px rgba(0,0,0,.35);
}
.art{
  width:50px; height:50px; border-radius:12px; flex:0 0 auto;
  background:var(--accent-c); display:flex; align-items:center; justify-content:center; font-size:22px;
}
.meta{flex:1; min-width:0;}
.meta .t{font-weight:700; font-size:13.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.meta .s{font-size:11px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.ctrls{display:flex; align-items:center; gap:6px; flex:0 0 auto;}
.cbtn{
  width:32px; height:32px; border-radius:50%; border:1px solid var(--line); background:var(--card2);
  color:var(--text); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:13px;
}
.cbtn.play{width:38px; height:38px; background:var(--accent-c); color:#141018; font-size:15px;}

.scroll-hint{
  text-align:center; padding:10px 0 4px; font-size:11px; color:var(--muted); letter-spacing:.5px;
}
.scroll-hint span{display:inline-block; animation:bob 1.6s ease-in-out infinite;}
@keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(4px);}}

/* ===== sections below the fold ===== */
.section{max-width:640px; margin:22px auto; padding:0 16px;}
.section h2{font-size:16px; margin:0 0 10px; font-weight:800;}
.track{
  display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:12px;
  background:var(--card); border:1px solid var(--line); margin-bottom:7px; cursor:pointer;
}
.track.playing{border-color:var(--accent-c); box-shadow:0 0 0 1px var(--accent-c) inset;}
.track .n{width:22px; text-align:center; color:var(--muted); font-size:12px; font-weight:700;}
.track .info{flex:1; min-width:0;}
.track .info .tt{font-weight:600; font-size:13.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.track .info .aa{font-size:11px; color:var(--muted);}
.track .play-ic{font-size:13px; color:var(--muted);}

.quote-card{
  background:var(--card); border:1px solid var(--line); border-radius:14px; padding:12px 16px;
  font-size:13px; font-style:italic; margin-bottom:8px;
}
.quote-card .who{display:block; margin-top:4px; font-style:normal; font-size:10.5px; opacity:.65; font-weight:700;}

.about-card{
  background:var(--card); border:1px solid var(--line); border-radius:16px; padding:18px;
  font-size:13px; line-height:1.7; color:var(--muted);
}
.about-card b{color:var(--text);}

.footer{text-align:center; padding:26px 16px 50px; font-size:11px; color:var(--muted);}
.footer b{color:var(--text);}

/* ===== floating chat button ===== */
.fab{
  position:fixed; bottom:20px; right:18px; z-index:80;
  width:56px; height:56px; border-radius:50%; background:var(--accent-c); color:#141018;
  display:flex; align-items:center; justify-content:center; font-size:24px; cursor:pointer;
  box-shadow:0 10px 26px rgba(0,0,0,.4); border:none;
}
.fab .badge{
  position:absolute; top:-4px; right:-4px; background:#ff4d4d; color:#fff; font-size:10px; font-weight:800;
  padding:2px 6px; border-radius:999px; display:none;
}

/* ===== chat drawer (hidden until opened) ===== */
.drawer-overlay{
  position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:90;
  display:none; align-items:flex-end; justify-content:center;
}
.drawer-overlay.open{display:flex;}
.chat-drawer{
  width:100%; max-width:640px; background:var(--card); border-radius:22px 22px 0 0;
  border:1px solid var(--line); border-bottom:none; height:78vh; display:flex; flex-direction:column;
  animation:slideUp .25s ease;
}
@keyframes slideUp{from{transform:translateY(30px); opacity:0;} to{transform:translateY(0); opacity:1;}}
.chat-head{
  display:flex; align-items:center; justify-content:space-between; padding:14px 16px;
  border-bottom:1px solid var(--line); font-weight:700; font-size:14px;
}
.chat-head .live{display:flex; align-items:center; gap:6px; font-size:11px; color:#3ddc74; font-weight:700;}
.chat-head .dot{width:6px;height:6px;border-radius:50%;background:#3ddc74;}
.chat-head .close-x{cursor:pointer; font-size:20px; color:var(--muted); padding:4px 8px;}
#msgs{flex:1; overflow-y:auto; padding:12px 14px; display:flex; flex-direction:column; gap:8px;}
.msg{max-width:80%; padding:8px 12px; border-radius:14px; font-size:13px; background:var(--card2); align-self:flex-start;}
.msg.me{align-self:flex-end; background:var(--accent-c); color:#141018;}
.msg .nm{font-size:10.5px; font-weight:800; opacity:.7; display:block; margin-bottom:2px;}
.chat-input{display:flex; gap:8px; padding:12px 14px; border-top:1px solid var(--line);}
.chat-input input{
  flex:1; background:var(--bg2); border:1px solid var(--line); border-radius:999px; padding:11px 14px;
  color:var(--text); font-size:13px; outline:none;
}
.chat-input button{
  background:var(--accent-c); border:none; color:#141018; font-weight:800; border-radius:999px;
  padding:0 16px; cursor:pointer; font-size:13px;
}
.chat-empty{color:var(--muted); font-size:12.5px; text-align:center; margin-top:40px;}
.chat-mode-note{font-size:10.5px; color:var(--muted); text-align:center; padding:6px 14px 0;}

/* ===== name modal ===== */
.name-modal{
  position:fixed; inset:0; background:rgba(0,0,0,.6); display:flex; align-items:center; justify-content:center;
  z-index:100; padding:20px;
}
.name-card{
  background:var(--card); border:1px solid var(--line); border-radius:18px; padding:22px; max-width:320px; width:100%;
  text-align:center;
}
.name-card h3{margin:0 0 6px; font-size:16px;}
.name-card p{margin:0 0 14px; font-size:12.5px; color:var(--muted);}
.name-card input{
  width:100%; padding:11px 14px; border-radius:12px; border:1px solid var(--line); background:var(--bg2);
  color:var(--text); font-size:14px; margin-bottom:12px; outline:none; text-align:center;
}
.name-card button{
  width:100%; padding:11px; border-radius:12px; border:none; background:var(--accent-c); color:#141018;
  font-weight:800; font-size:14px; cursor:pointer;
}
